{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(equipos|estadios|grupos|partidos)",
      "destination": "/api/index"
    },
    {
      "source": "/(equipos|estadios|grupos|partidos)/(.*)",
      "destination": "/api/index"
    }
  ]
}
